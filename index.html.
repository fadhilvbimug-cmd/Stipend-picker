<body>

<div class="box">

<h1>🔢 Stipend Number Picker</h1>

<div id="login">
<p>Enter your name and private PIN.</p>

<select id="name">
<option value="">-- Select your name --</option>
<option>Hellen</option>
<option>Aisha</option>
<option>Emmanuel</option>
<option>Saleh</option>
<option>Fadhil</option>
<option>Suzan</option>
</select>

<input id="pin" type="password" inputmode="numeric"
placeholder="Enter your private PIN">

<button id="loginBtn">Continue</button>
<div id="loginMessage"></div>
</div>


<div id="picker" class="hidden">

<p id="welcome"></p>

