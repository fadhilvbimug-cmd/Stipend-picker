from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
getFirestore,
doc,
getDoc,
setDoc,
deleteDoc,
collection,
getDocs,
writeBatch
}
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

import {
getAuth,
signInAnonymously,
signInWithEmailAndPassword
}
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";


const firebaseConfig={

apiKey:"AIzaSyBY95Fhm3--CmCvT5EKWrAZopRG42Lehk",
authDomain:"stipend-picker.firebaseapp.com",
projectId:"stipend-picker",
storageBucket:"stipend-picker.firebasestorage.app",
messagingSenderId:"82489349049",
appId:"1:82489349049:web:1e221bdcca579a48319c68",
measurementId:"G-Y95ZGQ9ERL"

};


const app=initializeApp(firebaseConfig);
const db=getFirestore(app);
const auth=getAuth(app);


/* PARTICIPANTS */

const people={
Hellen:"1842",
Aisha:"5271",
Emmanuel:"6394",
Saleh:"2816",
Fadhil:"7453",
Suzan:"9168"
};


let currentPerson=null;
let selectedNumber=null;


/* START */

async function start(){

try{

await signInAnonymously(auth);
await loadNumbers();

}catch(error){

console.error(error);

document.getElementById("loginMessage").textContent=
"Connection error. Please refresh.";

}

}


/* LOAD TAKEN NUMBERS */

async function loadNumbers(){

for(let i=1;i<=6;i++){

const ref=doc(db,"numbers",String(i));
const snap=await getDoc(ref);

const button=
document.querySelector(`[data-number="${i}"]`);

if(snap.exists()){

button.classList.add("taken");
button.textContent="✓";

}

}

}


/* LOGIN */

document.getElementById("loginBtn")
.addEventListener("click",async()=>{

const name=document.getElementById("name").value;
const pin=document.getElementById("pin").value;
const message=document.getElementById("loginMessage");


if(!name || !pin){

message.textContent="Please enter your name and PIN.";
return;

}


if(people[name]!==pin){

message.textContent="❌ Incorrect name or PIN.";
return;

}


/* CHECK ONLY THIS PERSON'S DOCUMENT */

const selectionRef=doc(db,"selections",name);
const existing=await getDoc(selectionRef);


if(existing.exists()){

document.getElementById("login").classList.add("hidden");
document.getElementById("picker").classList.remove("hidden");

document.getElementById("welcome").textContent=
`${name}, you have already selected a number.`;

document.getElementById("message").textContent=
`🔒 Your number is ${existing.data().number}. Your selection is locked.`;

document.querySelectorAll(".number")
.forEach(x=>x.classList.add("taken"));

document.getElementById("confirm").disabled=true;

return;

}


currentPerson=name;

document.getElementById("login").classList.add("hidden");
document.getElementById("picker").classList.remove("hidden");

document.getElementById("welcome").textContent=
`Welcome ${name}. Choose one number.`;

});


/* SELECT NUMBER */

document.querySelectorAll(".number")
.forEach(button=>{

button.addEventListener("click",()=>{

if(button.classList.contains("taken"))return;

document.querySelectorAll(".number")
.forEach(x=>x.classList.remove("selected"));

button.classList.add("selected");

selectedNumber=Number(button.dataset.number);

});

});


/* CONFIRM */

document.getElementById("confirm")
.addEventListener("click",async()=>{

const message=document.getElementById("message");

if(!currentPerson){

message.textContent="Please log in first.";
return;

}

if(!selectedNumber){

message.textContent="Please choose a number.";
return;

}


try{

/* CHECK PERSON AGAIN */

const selectionRef=
doc(db,"selections",currentPerson);

const existing=
await getDoc(selectionRef);

if(existing.exists()){

message.textContent=
`🔒 You already selected number ${existing.data().number}.`;

return;

}


/* CHECK NUMBER */

const numberRef=
doc(db,"numbers",String(selectedNumber));

const numberSnap=
await getDoc(numberRef);

if(numberSnap.exists()){

message.textContent=
"❌ That number has already been taken.";

await loadNumbers();

return;

}


/* SAVE BOTH */

const batch=writeBatch(db);

batch.set(numberRef,{
taken:true
});

batch.set(selectionRef,{

name:currentPerson,

number:selectedNumber,

uid:auth.currentUser.uid,

time:new Date().toISOString()

});

await batch.commit();


message.textContent=
`✅ ${currentPerson}, your number is ${selectedNumber}.`;

document.querySelectorAll(".number")
.forEach(x=>x.classList.add("taken"));

document.getElementById("confirm").disabled=true;

selectedNumber=null;


}catch(error){

console.error(error);

message.textContent=
"❌ Something went wrong. Please try again.";

}

});


/* HOST LOGIN */

document.getElementById("hostLogin")
.addEventListener("click",async()=>{

const email=prompt("Host email:");
if(!email)return;

const password=prompt("Host password:");
if(!password)return;


try{

await signInWithEmailAndPassword(
auth,email,password
);

document.getElementById("hostPanel")
.style.display="block";

await showResults();

}catch(error){

alert("Host login failed.");

}

});


/* HOST RESULTS */

async function showResults(){

const results=document.getElementById("results");

results.innerHTML="";

const snap=
await getDocs(collection(db,"selections"));

const data={};

snap.forEach(item=>{

const x=item.data();
data[x.name]=x.number;

});


Object.keys(people).forEach(name=>{

const div=document.createElement("div");

div.className="result";

div.textContent=
`${name}: ${data[name]||"Not selected"}`;

results.appendChild(div);

});

}


/* HOST RESET */

document.getElementById("reset")
.addEventListener("click",async()=>{

if(!confirm("Reset ALL selections?"))return;

try{

const numbers=
await getDocs(collection(db,"numbers"));

const selections=
await getDocs(collection(db,"selections"));

const batch=writeBatch(db);

numbers.forEach(x=>batch.delete(x.ref));
selections.forEach(x=>batch.delete(x.ref));

await batch.commit();

alert("Draw reset successfully.");

location.reload();

}catch(error){

console.error(error);

alert("Reset failed.");

}

});


start();

</script>

