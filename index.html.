<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stipend Number Picker</title>

<style>
*{
  box-sizing:border-box;
}

body{
  font-family:Arial,sans-serif;
  background:#f3f4f6;
  margin:0;
  padding:20px;
}

.box{
  max-width:500px;
  margin:auto;
  background:white;
  padding:25px;
  border-radius:18px;
  box-shadow:0 4px 15px #0002;
}

h1,h2{
  text-align:center;
}

select,input,button{
  width:100%;
  padding:14px;
  margin-top:12px;
  border-radius:10px;
  box-sizing:border-box;
  font-size:16px;
}

select,input{
  border:1px solid #ccc;
}

button{
  border:0;
  background:#111827;
  color:white;
  cursor:pointer;
}

button:disabled{
  background:#9ca3af;
  cursor:not-allowed;
}

.numbers{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-top:20px;
}

.number{
  padding:22px 5px;
  text-align:center;
  font-size:26px;
  font-weight:bold;
  background:#e5e7eb;
  border-radius:12px;
  cursor:pointer;
  user-select:none;
}

.number:hover{
  background:#d1d5db;
}

.number.selected{
  background:#2563eb;
  color:white;
}

.number.taken{
  background:#aaa;
  color:white;
  cursor:not-allowed;
}

#message,
#loginMessage{
  text-align:center;
  font-weight:bold;
  margin-top:18px;
}

#hostPanel{
  display:none;
  margin-top:30px;
}

.result{
  padding:12px;
  margin:7px 0;
  background:#f1f5f9;
  border-radius:8px;
}

.danger{
  background:#dc2626;
}

.hidden{
  display:none;
}

.success{
  color:#15803d;
}

.error{
  color:#dc2626;
}

.info{
  color:#1d4ed8;
}

.pin-note{
  font-size:14px;
  color:#666;
  text-align:center;
  margin-top:8px;
}
</style>
</head>

<body>

<div class="box">

<h1>🔢 Stipend Number Picker</h1>

<!-- LOGIN -->

<div id="login">

<p>Enter your name and private PIN.</p>

<select id="name">
<option value="">-- Select your name --</option>
<option value="Hellen">Hellen</option>
<option value="Aisha">Aisha</option>
<option value="Emmanuel">Emmanuel</option>
<option value="Saleh">Saleh</option>
<option value="Fadhil">Fadhil</option>
<option value="Suzan">Suzan</option>
</select>

<input
  id="pin"
  type="password"
  inputmode="numeric"
  maxlength="4"
  placeholder="Enter your private PIN"
  autocomplete="off"
>

<div class="pin-note">
Your PIN is private. Do not share it with anyone.
</div>

<button id="loginBtn">
Continue
</button>

<div id="loginMessage"></div>

</div>


<!-- NUMBER PICKER -->

<div id="picker" class="hidden">

<p id="welcome"></p>

<div class="numbers">

<div class="number" data-number="1">1</div>
<div class="number" data-number="2">2</div>
<div class="number" data-number="3">3</div>
<div class="number" data-number="4">4</div>
<div class="number" data-number="5">5</div>
<div class="number" data-number="6">6</div>

</div>

<button id="confirm">
Confirm My Number
</button>

<div id="message"></div>

</div>


<hr style="margin:30px 0">


<!-- HOST -->

<button id="hostLogin">
👑 Host Dashboard
</button>

<div id="hostPanel">

<h2>Host Dashboard</h2>

<div id="results"></div>

<button class="danger" id="reset">
Reset Entire Draw
</button>

</div>

</div>


<script type="module">

/* =========================================================
   FIREBASE IMPORTS
========================================================= */

import {
  initializeApp
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getFirestore,
  doc,
  getDoc,
  setDoc,
  collection,
  getDocs,
  writeBatch,
  runTransaction
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

import {
  getAuth,
  signInAnonymously,
  signInWithEmailAndPassword
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";


/* =========================================================
   FIREBASE CONFIG
========================================================= */

const firebaseConfig = {

  apiKey:
    "AIzaSyBY95Fhm3--CmCvT5EKWrAZopRG42Lehk",

  authDomain:
    "stipend-picker.firebaseapp.com",

  projectId:
    "stipend-picker",

  storageBucket:
    "stipend-picker.firebasestorage.app",

  messagingSenderId:
    "82489349049",

  appId:
    "1:82489349049:web:1e221bdcca579a48319c68",

  measurementId:
    "G-Y95ZGQ9ERL"

};


/* =========================================================
   INITIALIZE FIREBASE
========================================================= */

const app = initializeApp(firebaseConfig);

const db = getFirestore(app);

const auth = getAuth(app);


/* =========================================================
   PARTICIPANTS AND PRIVATE PINS
========================================================= */

const people = {

  Hellen: "1842",

  Aisha: "5271",

  Emmanuel: "6394",

  Saleh: "2816",

  Fadhil: "7453",

  Suzan: "9168"

};


/* =========================================================
   VARIABLES
========================================================= */

let currentPerson = null;

let selectedNumber = null;


/* =========================================================
   ELEMENTS
========================================================= */

const loginDiv =
  document.getElementById("login");

const pickerDiv =
  document.getElementById("picker");

const nameInput =
  document.getElementById("name");

const pinInput =
  document.getElementById("pin");

const loginBtn =
  document.getElementById("loginBtn");

const loginMessage =
  document.getElementById("loginMessage");

const welcome =
  document.getElementById("welcome");

const message =
  document.getElementById("message");

const confirmBtn =
  document.getElementById("confirm");

const numberButtons =
  document.querySelectorAll(".number");


/* =========================================================
   START APPLICATION
========================================================= */

async function start(){

  try{

    await signInAnonymously(auth);

    await loadNumbers();

  }catch(error){

    console.error("START ERROR:",error);

    loginMessage.className = "error";

    loginMessage.textContent =
      "❌ Unable to connect. Please refresh the page.";

  }

}


/* =========================================================
   LOAD TAKEN NUMBERS
========================================================= */

async function loadNumbers(){

  for(let i = 1; i <= 6; i++){

    try{

      const numberRef =
        doc(db,"numbers",String(i));

      const snapshot =
        await getDoc(numberRef);

      const button =
        document.querySelector(
          `[data-number="${i}"]`
        );

      if(!button) continue;


      if(snapshot.exists()){

        button.classList.add("taken");

        button.classList.remove("selected");

        button.textContent = "✓";

      }else{

        button.classList.remove("taken");

        button.textContent = i;

      }

    }catch(error){

      console.error(
        "Error loading number:",
        i,
        error
      );

    }

  }

}


/* =========================================================
   LOGIN
========================================================= */

loginBtn.addEventListener(
  "click",
  async()=>{

    loginMessage.textContent = "";
    loginMessage.className = "";

    const name =
      nameInput.value.trim();

    const pin =
      pinInput.value.trim();


    /* CHECK NAME */

    if(!name){

      loginMessage.className = "error";

      loginMessage.textContent =
        "Please select your name.";

      return;

    }


    /* CHECK PIN */

    if(!pin){

      loginMessage.className = "error";

      loginMessage.textContent =
        "Please enter your PIN.";

      return;

    }


    /* CHECK PIN */

    if(people[name] !== pin){

      loginMessage.className = "error";

      loginMessage.textContent =
        "❌ Incorrect name or PIN.";

      pinInput.value = "";

      return;

    }


    loginBtn.disabled = true;

    loginBtn.textContent = "Checking...";


    try{

      /* MAKE SURE FIREBASE LOGIN EXISTS */

      if(!auth.currentUser){

        await signInAnonymously(auth);

      }


      /* CHECK WHETHER PERSON ALREADY SELECTED */

      const selectionRef =
        doc(db,"selections",name);

      const existing =
        await getDoc(selectionRef);


      if(existing.exists()){

        const existingNumber =
          existing.data().number;


        currentPerson = name;


        loginDiv.classList.add("hidden");

        pickerDiv.classList.remove("hidden");


        welcome.textContent =
          `${name}, you have already selected a number.`;


        message.className = "info";

        message.textContent =
          `🔒 Your number is ${existingNumber}. Your selection is permanently locked.`;


        /* SHOW ALL NUMBERS AS LOCKED */

        numberButtons.forEach(button=>{

          button.classList.add("taken");

          button.classList.remove("selected");

          button.style.cursor = "not-allowed";

        });


        confirmBtn.disabled = true;

        return;

      }


      /* NORMAL LOGIN */

      currentPerson = name;

      selectedNumber = null;


      loginDiv.classList.add("hidden");

      pickerDiv.classList.remove("hidden");


      welcome.textContent =
        `Welcome ${name}. Choose one number.`;


      message.textContent = "";


      /* REFRESH NUMBER STATUS */

      await loadNumbers();


    }catch(error){

      console.error(
        "LOGIN ERROR:",
        error
      );

      loginMessage.className = "error";

      loginMessage.textContent =
        "❌ Something went wrong while connecting to the server.";

    }finally{

      loginBtn.disabled = false;

      loginBtn.textContent = "Continue";

    }

  }
);


/* =========================================================
   PRESS ENTER TO LOGIN
========================================================= */

pinInput.addEventListener(
  "keydown",
  event=>{

    if(event.key === "Enter"){

      loginBtn.click();

    }

  }
);


/* =========================================================
   SELECT NUMBER
========================================================= */

numberButtons.forEach(button=>{

  button.addEventListener(
    "click",
    async()=>{

      /* DO NOT ALLOW CLICK IF TAKEN */

      if(button.classList.contains("taken")){

        return;

      }


      /* DO NOT ALLOW WITHOUT LOGIN */

      if(!currentPerson){

        message.className = "error";

        message.textContent =
          "Please log in first.";

        return;

      }


      /* REMOVE OLD SELECTION */

      numberButtons.forEach(x=>{

        x.classList.remove("selected");

      });


      /* SELECT THIS NUMBER */

      button.classList.add("selected");

      selectedNumber =
        Number(button.dataset.number);


      message.className = "info";

      message.textContent =
        `You selected number ${selectedNumber}. Press "Confirm My Number" to lock it.`;

    }
  );

});


/* =========================================================
   CONFIRM NUMBER
========================================================= */

confirmBtn.addEventListener(
  "click",
  async()=>{

    message.textContent = "";
    message.className = "";


    /* CHECK LOGIN */

    if(!currentPerson){

      message.className = "error";

      message.textContent =
        "Please log in first.";

      return;

    }


    /* CHECK NUMBER */

    if(!selectedNumber){

      message.className = "error";

      message.textContent =
        "Please choose a number.";

      return;

    }


    confirmBtn.disabled = true;

    confirmBtn.textContent =
      "Saving...";


    try{

      const personName =
        currentPerson;

      const number =
        selectedNumber;


      const selectionRef =
        doc(
          db,
          "selections",
          personName
        );


      const numberRef =
        doc(
          db,
          "numbers",
          String(number)
        );


      /* =====================================================
         TRANSACTION
         
         This is important.

         It checks BOTH the person's selection and the
         number at the exact time the selection is saved.

         Therefore two people cannot claim the same number
         simultaneously.
      ===================================================== */

      await runTransaction(
        db,
        async(transaction)=>{

          const personSnapshot =
            await transaction.get(
              selectionRef
            );


          const numberSnapshot =
            await transaction.get(
              numberRef
            );


          /* PERSON ALREADY SELECTED */

          if(personSnapshot.exists()){

            throw new Error(
              "PERSON_ALREADY_SELECTED"
            );

          }


          /* NUMBER ALREADY TAKEN */

          if(numberSnapshot.exists()){

            throw new Error(
              "NUMBER_ALREADY_TAKEN"
            );

          }


          /* SAVE NUMBER */

          transaction.set(
            numberRef,
            {
              taken:true,
              number:number,
              name:personName,
              time:new Date().toISOString()
            }
          );


          /* SAVE PERSON SELECTION */

          transaction.set(
            selectionRef,
            {
              name:personName,
              number:number,
              uid:auth.currentUser
                ? auth.currentUser.uid
                : "",
              time:new Date().toISOString()
            }
          );

        }
      );


      /* =====================================================
         SUCCESS
      ===================================================== */

      message.className = "success";

      message.textContent =
        `✅ ${personName}, your number is ${number}. Your selection is now permanently locked.`;


      /* LOCK ALL NUMBERS ON SCREEN */

      numberButtons.forEach(button=>{

        button.classList.add("taken");

        button.classList.remove("selected");

        button.style.cursor =
          "not-allowed";

      });


      confirmBtn.disabled = true;

      selectedNumber = null;


      /* REFRESH FROM FIREBASE */

      await loadNumbers();


    }catch(error){

      console.error(
        "CONFIRM ERROR:",
        error
      );


      /* NUMBER WAS TAKEN */

      if(
        error.message ===
        "NUMBER_ALREADY_TAKEN"
      ){

        message.className = "error";

        message.textContent =
          "❌ Sorry, that number has already been taken by someone else. Please choose another number.";

        selectedNumber = null;

        await loadNumbers();


        confirmBtn.disabled = false;

        confirmBtn.textContent =
          "Confirm My Number";

        return;

      }


      /* PERSON ALREADY SELECTED */

      if(
        error.message ===
        "PERSON_ALREADY_SELECTED"
      ){

        message.className = "error";

        message.textContent =
          "🔒 You have already selected a number. Your selection cannot be changed.";

        confirmBtn.disabled = true;

        return;

      }


      /* FIREBASE / OTHER ERROR */

      message.className = "error";

      message.textContent =
        "❌ Something went wrong while saving. Please check your internet connection and try again.";

      confirmBtn.disabled = false;

      confirmBtn.textContent =
        "Confirm My Number";

    }

  }
);


/* =========================================================
   HOST LOGIN
========================================================= */

document.getElementById(
  "hostLogin"
).addEventListener(
  "click",
  async()=>{

    const email =
      prompt("Host email:");

    if(!email) return;


    const password =
      prompt("Host password:");

    if(!password) return;


    try{

      await signInWithEmailAndPassword(
        auth,
        email,
        password
      );


      document.getElementById(
        "hostPanel"
      ).style.display = "block";


      await showResults();


    }catch(error){

      console.error(
        "HOST LOGIN ERROR:",
        error
      );

      alert(
        "Host login failed. Check your email and password."
      );

    }

  }
);


/* =========================================================
   HOST RESULTS
========================================================= */

async function showResults(){

  const results =
    document.getElementById(
      "results"
    );

  results.innerHTML =
    "<p>Loading...</p>";


  try{

    const snapshot =
      await getDocs(
        collection(
          db,
          "selections"
        )
      );


    const data = {};


    snapshot.forEach(item=>{

      const x =
        item.data();

      data[x.name] =
        x.number;

    });


    results.innerHTML = "";


    Object.keys(people)
      .forEach(name=>{

        const div =
          document.createElement(
            "div"
          );

        div.className =
          "result";


        if(data[name]){

          div.textContent =
            `${name}: Number ${data[name]} ✓`;

        }else{

          div.textContent =
            `${name}: Not selected`;

        }


        results.appendChild(div);

      });


  }catch(error){

    console.error(
      "RESULT ERROR:",
      error
    );

    results.innerHTML =
      "<p>❌ Unable to load results.</p>";

  }

}


/* =========================================================
   HOST RESET
========================================================= */

document.getElementById(
  "reset"
).addEventListener(
  "click",
  async()=>{

    const answer =
      confirm(
        "⚠️ Are you sure you want to reset ALL selections?"
      );


    if(!answer) return;


    try{

      const numbers =
        await getDocs(
          collection(
            db,
            "numbers"
          )
        );


      const selections =
        await getDocs(
          collection(
            db,
            "selections"
          )
        );


      const batch =
        writeBatch(db);


      numbers.forEach(
        item=>{

          batch.delete(
            item.ref
          );

        }
      );


      selections.forEach(
        item=>{

          batch.delete(
            item.ref
          );

        }
      );


      await batch.commit();


      alert(
        "✅ Draw reset successfully."
      );


      location.reload();


    }catch(error){

      console.error(
        "RESET ERROR:",
        error
      );


      alert(
        "❌ Reset failed."
      );

    }

  }
);


/* =========================================================
   START
========================================================= */

start();

</script>

</body>
</html>
